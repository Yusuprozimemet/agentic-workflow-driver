# --- dashboard: what scripts/spec-drift.py read from git, kept between runs, and its output ---
.spec-drift-cache.json
.evidence-cache.json
spec-drift.json
__pycache__/
# what close-evidence.py --rehearse writes at the root before a closing PR
evidence-rehearsal.json
