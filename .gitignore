docs/dashboard/token-usage.json
docs/dashboard/refusals.json
docs/dashboard/gates.json
docs/dashboard/sessions.json
docs/dashboard/counted.json
docs/dashboard/driver-runs.json
docs/dashboard/replay-history.json

# --- Bash output the hook saved in full (scripts/cap-output.py) ---
.claude/tool-output/

# --- the step guard's marker: set on "merged", cleared by a new session (scripts/step-guard.py) ---
.claude/state/

# --- local secrets ---
.env

# --- the driver's own: its config and its state folder (halt, lock, settings), never committed ---
/driver.json
/state/
